NODE_ENV=production
APP_URL=https://__DOMAIN__
APP_KEY=__APP_KEY__
HOST=127.0.0.1
PORT=__PORT__

DB_CONNECTION=sqlite
DB_DATABASE=ferdium
DB_SSL=false
DATA_DIR=__DATA_DIR__
DB_SQLITE_JOURNAL_MODE=WAL
DB_SQLITE_SYNCHRONOUS=FULL
DB_BUSY_TIMEOUT=5000

MAIL_CONNECTION=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=25
MAIL_SSL=false
MAIL_SENDER=ferdium@__DOMAIN__

IS_CREATION_ENABLED=__CREATION_ENABLED__
IS_DASHBOARD_ENABLED=__DASHBOARD_ENABLED__
IS_REGISTRATION_ENABLED=__REGISTRATION_ENABLED__
CONNECT_WITH_FRANZ=false
CACHE_VIEWS=false
